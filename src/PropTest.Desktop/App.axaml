<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PropTest.Desktop.App" RequestedThemeVariant="Light">
 <Application.Styles>
  <FluentTheme/>
  <Style Selector="Window"><Setter Property="Background" Value="#EEF1F5"/><Setter Property="FontFamily" Value="Inter, Segoe UI"/></Style>
  <Style Selector="Border.card"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18"/></Style>
  <Style Selector="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="CornerRadius" Value="6"/></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="#C44F0A"/><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="Button.stop"><Setter Property="Background" Value="#B42318"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#556274"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Application.Styles>
</Application>
